{
    "name": "markor/docuview",
    "description": "DocuView - Document and Code Viewer",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "erusev/parsedown": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}